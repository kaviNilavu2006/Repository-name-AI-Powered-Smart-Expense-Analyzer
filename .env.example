# Copy this file to .env for LOCAL development only.
# NEVER commit .env or real secrets to GitHub.
# In AWS Elastic Beanstalk, set these as environment properties instead.

# Flask
SECRET_KEY=generate-a-long-random-secret
FLASK_ENV=development
FLASK_DEBUG=True

# AWS
AWS_REGION=ap-south-1

# DynamoDB
DYNAMODB_TABLE_NAME=ExpenseAnalyzerExpenses
DYNAMODB_USERS_TABLE_NAME=ExpenseAnalyzerUsers

# S3
S3_BUCKET_NAME=your-unique-bucket-name
S3_PRESIGNED_URL_EXPIRY=3600

# Bedrock
BEDROCK_MODEL_ID=your-enabled-model-id
BEDROCK_REGION=ap-south-1
BEDROCK_ENABLED=True

# Uploads
MAX_UPLOAD_SIZE_MB=5
LOCAL_UPLOAD_FOLDER=uploads
USE_LOCAL_STORAGE_FALLBACK=True

# Demo mode
DEMO_MODE=False
